{"nodes": [{"id": "public_p04_planning", "label": "Planning (Analytical Text Response Essays)", "file_type": "document", "source_file": "public/p04-planning.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "essay_hinge_sentence", "label": "Hinge Sentence Technique", "file_type": "rationale", "source_file": "public/p04-planning.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Introducing two related ideas in a topic sentence (linked by because/but/so) and bridging them with a hinge sentence signals a shift in focus to the reader, producing a more complex and insightful paragraph than single-idea contentions."}, {"id": "essay_contention", "label": "Contention (Essay Writing)", "file_type": "rationale", "source_file": "public/p04-planning.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A contention should be specific and sophisticated rather than general, engaging directly with authorial intent and character motivation so the marker can see a clear, defensible position on the prompt."}], "edges": [{"source": "public_p04_planning", "target": "essay_contention", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "public/p04-planning.html", "source_location": null, "weight": 1.0}, {"source": "public_p04_planning", "target": "essay_hinge_sentence", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "public/p04-planning.html", "source_location": null, "weight": 1.0}, {"source": "public_p04_planning", "target": "rainbows_end", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "public/p04-planning.html", "source_location": null, "weight": 1.0}, {"source": "public_p04_planning", "target": "gladys_banks", "relation": "references", "confi